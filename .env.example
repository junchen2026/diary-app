# Copy to .env for local use and fill in. In production the same keys are
# secrets/variables of the GitHub "production" environment (see README).

# Host port nginx listens on: 8080 locally, 80 on EC2
HTTP_PORT=8080

# PostgreSQL. Postgres only applies these when the database volume is first
# created; changing PGPASSWORD later needs the rotation steps in the README.
PGDATABASE=riji
PGUSER=riji
PGPASSWORD=change-me

# Super admin master key (32 bytes hex = 64 chars). Generate: openssl rand -hex 32
# Encrypts stored data — changing it later makes existing data unreadable.
SUPER_ADMIN_MASTER_KEY=

# JWT secret for session tokens. Generate: openssl rand -hex 32
JWT_SECRET=

# SMTP (optional - codes logged to console if not set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=riji@localhost

# Translation (OpenAI-compatible API). Without a key the Translate button returns an error.
# Base URL and model default to agnes-ai if left empty.
TRANSLATE_API_KEY=
TRANSLATE_API_BASE_URL=
TRANSLATE_MODEL=
